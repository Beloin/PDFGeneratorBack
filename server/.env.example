# Copy to .env and configure this project.
PDF_LISTEN_ADDR=:8080
PDF_DATA_DIR=/absolute/path/to/pdf-editor-back/tmp
# Empty uses the renderer staged by BUILD; set a path for direct runs.
PDF_GEN_PATH=
# Optional direct-run override; Heph supplies the installed LibreOffice tool by default.
# LIBREOFFICE=/usr/bin/libreoffice
PDF_PYTHON=/absolute/path/to/home/.cache/pdf-editor-back/venv/bin/python3
AUTH_TOKEN=
